/*
 * SnowGauge board overlay for Seeed XIAO nRF52840 Sense on PCB v1.2.
 * Pin map source of truth: pcb/README.md
 *
 *   D10 (P1.15) SENSOR_EN  high = sensor rail ON (Q2 -> Q1 high-side switch)
 *   A0  (P0.02) ADC_NODE   VBAT_SW / 2 (1M + 1M divider, 0 V while rail off)
 *   D6  (P1.11) UART TX    -> 1k (R7) -> TFmini RX (white)
 *   D7  (P1.12) UART RX    <- TFmini TX (green)
 *   D4/D5       I2C        spare header J3
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
	/*
	 * Console + shell: the board already routes zephyr,console and
	 * zephyr,shell-uart to USB CDC ACM (board_cdc_acm_uart), so uart0 is free
	 * for the TFmini.
	 */

	zephyr,user {
		sensor-en-gpios = <&xiao_d 10 GPIO_ACTIVE_HIGH>;
		io-channels = <&adc 0>;
	};

	aliases {
		tfmini-uart = &uart0;
	};
};

/* TFmini Plus: 115200 8N1, 100 Hz, 9-byte frames (board default pins D6/D7). */
&uart0 {
	status = "okay";
	current-speed = <115200>;
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * Battery divider on A0. Full scale = 0.6 V * 6 = 3.6 V, which covers
	 * VBAT_SW/2 up to 7.2 V (fresh L91 x4). The 500k source impedance
	 * needs the longest SAADC acquisition time (40 us, good to 800k).
	 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};


/*
 * The on-board IMU is powered by a GPIO regulator that the board enables
 * at boot with only a 3 ms start-up delay; the LSM6DS3TR-C needs ~15 ms
 * before it answers on I2C, so its driver init fails when run from the
 * init tables. Defer it and let tilt_init() initialise it after a delay.
 */
&lsm6ds3tr_c {
	zephyr,deferred-init;
};

/*
 * Record storage (step 4a).
 *
 * QSPI (2 MB P25Q16H): one LittleFS partition over the whole chip. The
 * driver uses runtime PM so the chip sits in deep power-down between
 * accesses (~1 uA) without any help from the application.
 */
&p25q16h {
	zephyr,pm-device-runtime-auto;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		lfs1_part: partition@0 {
			label = "lfs";
			reg = <0x00000000 0x00200000>;
		};
	};
};

/ {
	fstab {
		compatible = "zephyr,fstab";

		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs1_part>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};

	/* Emulated calendar clock behind the `rtc` alias (timekeeping.c, mcumgr datetime). */
	rtc_emul: rtc-emul {
		compatible = "zephyr,rtc-emul";
		status = "okay";
	};

	aliases {
		rtc = &rtc_emul;
	};
};

/*
 * Internal flash (1 MB). The board's UF2 layout gives the application
 * 788 kB; SnowGauge needs < 480 kB even with BLE, so the tail of that
 * region becomes the record mirror (308 kB = 7,884 records of 40 B).
 *
 *   0x00000  156 kB  Adafruit bootloader + SoftDevice area (untouched)
 *   0x27000  480 kB  Application (this image)
 *   0x9F000  308 kB  mirror_partition (raw append-only records)
 *   0xEC000   32 kB  storage_partition (settings, future calibration data)
 *   0xF4000   48 kB  bootloader UF2 area (untouched)
 */
&code_partition {
	reg = <0x00027000 0x00078000>;
};

&flash0 {
	partitions {
		mirror_partition: partition@9f000 {
			label = "mirror";
			reg = <0x0009f000 0x0004d000>;
		};
	};
};
