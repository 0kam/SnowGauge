# SnowGauge application options

menu "SnowGauge application"

choice SNOWGAUGE_SENSOR
	prompt "Distance sensor (hardware variant, spec section 3.2)"
	default SNOWGAUGE_SENSOR_TFMINI
	help
	  Both variants share PCB v1.2; only U2 (sensor LDO) and the sensor
	  differ. Select with overlay-tsd20.conf for the TSD20 build.

config SNOWGAUGE_SENSOR_TFMINI
	bool "Benewake TFmini Plus (5 V, U2 = NJU7223F50, 115200 baud)"

config SNOWGAUGE_SENSOR_TSD20
	bool "PONO TSD20 (3.3 V, U2 = NJU7223F33, 460800 baud)"

endchoice

config SNOWGAUGE_RAIL_SETTLE_MS
	int "Sensor rail settle time before touching the UART (ms)"
	default 300
	help
	  Delay between driving SENSOR_EN high and resuming the sensor UART.
	  Covers LDO start-up, the 470uF OS-CON charge and the sensor boot.

config SNOWGAUGE_LIDAR_SAMPLES
	int "Number of LiDAR frames per measurement (N)"
	default 100
	range 1 512
	help
	  Frames collected per measurement cycle; the median, variance and
	  quality counters are computed over this burst. 100 frames take
	  about 1 s on the TFmini Plus (100 Hz) and 0.5 s on the TSD20 (200 Hz).

config SNOWGAUGE_LIDAR_CAPTURE_TIMEOUT_MS
	int "Maximum time to wait for the N frames (ms)"
	default 3000

config SNOWGAUGE_LIDAR_RETRY
	bool "Power-cycle the sensor and retry once when a capture yields no frames"
	default y
	help
	  A sensor that does not answer at all (0 frames within the capture
	  timeout) is switched off for SNOWGAUGE_LIDAR_RETRY_OFF_MS and the
	  capture is repeated once. The record then carries the RETRIED flag.

config SNOWGAUGE_LIDAR_RETRY_OFF_MS
	int "Sensor rail off time before the retry (ms)"
	default 1000
	depends on SNOWGAUGE_LIDAR_RETRY

config SNOWGAUGE_TIME_SAVE_MIN
	int "Period of the wall-clock checkpoint in the settings (min, 0 = off)"
	default 60
	help
	  The clock is lost on reset and otherwise restored from the newest
	  record only. Saving it periodically (NVS key sgt/epoch) bounds the
	  error after a watchdog reset to this period even when no record was
	  written for days.

config SNOWGAUGE_TFMINI_MIN_STRENGTH
	int "Minimum TFmini signal strength for a distance to count as valid"
	default 100
	depends on SNOWGAUGE_SENSOR_TFMINI
	help
	  Benewake documents distances as unreliable below a strength of 100.

choice SNOWGAUGE_SENSOR_AXIS
	prompt "Direction of the LiDAR optical axis in the IMU frame"
	default SNOWGAUGE_SENSOR_AXIS_NEG_Y
	help
	  The tilt angle is measured between gravity and this axis, so it is
	  the deviation of the laser from nadir whatever way the PCB is mounted.

config SNOWGAUGE_SENSOR_AXIS_NEG_Y
	bool "IMU -Y points down: PCB vertical, USB to the left, sensor terminal J2 up (enclosure v1)"
	help
	  Mounting orientation since 2026-09-11 (180 deg in-plane from the
	  earlier one): USB to the left, J2 up, battery terminal J1 to the
	  right, D0-D6 (TX) pin row down. The accelerometer then reads
	  a = (0, +1, 0) g, i.e. -Y points down along the laser (it reads
	  +1 g on the axis that points up). pitch = component toward +X
	  (in-plane, battery side), roll = component toward +Z (out of plane,
	  component side).

config SNOWGAUGE_SENSOR_AXIS_POS_Y
	bool "IMU +Y points down: PCB vertical, USB to the right, D0-D6 (TX) pin row up"
	help
	  The mirror image of the above, used between 2026-09-07 and
	  2026-09-11: the accelerometer reads a = (0, -1, 0) g. pitch and roll
	  keep their meaning (+X in-plane, +Z out of plane).

config SNOWGAUGE_SENSOR_AXIS_Z
	bool "IMU +/-Z: PCB horizontal (flat breadboard on the bench)"
	help
	  Either face up. pitch = component toward +X, roll = toward +Y.
	  Firmware before 2026-09-07 always used this.

endchoice

config SNOWGAUGE_TILT_SAMPLES
	int "Accelerometer samples averaged per tilt reading"
	default 16
	range 1 255

config SNOWGAUGE_IMU_POWER_GATE
	bool "Cut the IMU supply between readings"
	default y
	help
	  Disable the on-board LSM6DS3TR-C regulator (P1.08) while idle instead
	  of relying on the chip's power-down mode.

config SNOWGAUGE_AUTO_MEASURE_PERIOD_S
	int "Automatic measurement period at boot (s, 0 = shell only)"
	default 0
	help
	  When non-zero the firmware runs a full measurement cycle every N
	  seconds without any shell interaction. Can be changed at run time
	  with the 'auto' shell command.

config SNOWGAUGE_BLE_ADV_INT_MIN_MS
	int "BLE advertising interval, minimum (ms)"
	default 1000
	range 20 10240
	help
	  Spec section 12.2: 1-2 s. The interval is the main BLE power knob;
	  can be changed at run time with the 'ble adv' shell command.

config SNOWGAUGE_BLE_ADV_INT_MAX_MS
	int "BLE advertising interval, maximum (ms)"
	default 2000
	range 20 10240

config SNOWGAUGE_VBAT_MIN_MV
	int "Minimum battery voltage for a LiDAR capture (mV)"
	default 4600 if SNOWGAUGE_SENSOR_TFMINI
	default 3800 if SNOWGAUGE_SENSOR_TSD20
	help
	  Below this the sensor LDO is out of regulation and the capture burst
	  can brown out the board; the measurement then records only Vbat,
	  tilt and temperature. TFmini Plus: 5 V LDO + 120 mA. TSD20: 3.3 V
	  LDO (0.4 V dropout) + 70 mA, i.e. nearly the whole L91 capacity.

config SNOWGAUGE_BOOT_HOLDOFF_MIN
	int "Delay of the first scheduled measurement after a reset (min)"
	default 10
	help
	  A reset restores the clock from the last record, which would make the
	  scheduler fire immediately (and again after every brown-out reset).
	  The first scheduled measurement is held off by this many minutes,
	  multiplied by the number of resets within the last hold-off window.

config SNOWGAUGE_BOOT_MAX_RESETS
	int "Consecutive resets after which scheduled measurements are halted"
	default 12
	range 2 15
	help
	  Counted in GPREGRET2 (cleared after one hold-off window of normal
	  operation, or by a power cycle). Past this count the device keeps
	  advertising and answering BLE but does not measure until the next
	  reboot: a reset loop (brown-out, crash) then cannot drain the cells.

config SNOWGAUGE_WDT_TIMEOUT_S
	int "Hardware watchdog timeout (s)"
	default 120
	range 30 3600
	help
	  Fed every quarter of this period by the supervisor in wdt_mon.c while
	  all subsystems are alive. Must be comfortably longer than the
	  bootloader's start-up (it feeds the WDT itself only in the DFU wait
	  loop) and the longest sensor capture.

config SNOWGAUGE_SCHED_DEFAULT_INTERVAL_MIN
	int "Default measurement interval until configured (min, 0 = off)"
	default 180
	help
	  Spec: 8 measurements/day. Overridden by the stored sg/sched/* settings.

config SNOWGAUGE_SCHED_DEFAULT_TZ_MIN
	int "Default UTC offset of the site (min)"
	default 540

endmenu

source "Kconfig.zephyr"
