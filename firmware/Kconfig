# SnowGauge application options

menu "SnowGauge application"

config SNOWGAUGE_RAIL_SETTLE_MS
	int "Sensor rail settle time before touching the UART (ms)"
	default 300
	help
	  Delay between driving SENSOR_EN high and resuming the TFmini UART.
	  Covers LDO start-up, the 470uF OS-CON charge and the TFmini boot.

config SNOWGAUGE_TFMINI_SAMPLES
	int "Number of TFmini frames per measurement (N)"
	default 100
	range 1 512
	help
	  Frames collected per measurement cycle; the median, variance and
	  quality counters are computed over this burst. At the default
	  100 Hz frame rate 100 frames take about 1 s.

config SNOWGAUGE_TFMINI_CAPTURE_TIMEOUT_MS
	int "Maximum time to wait for the N frames (ms)"
	default 3000

config SNOWGAUGE_TFMINI_MIN_STRENGTH
	int "Minimum TFmini signal strength for a distance to count as valid"
	default 100
	help
	  Benewake documents distances as unreliable below a strength of 100.

config SNOWGAUGE_TILT_SAMPLES
	int "Accelerometer samples averaged per tilt reading"
	default 16
	range 1 255

config SNOWGAUGE_IMU_POWER_GATE
	bool "Cut the IMU supply between readings"
	default y
	help
	  Disable the on-board LSM6DS3TR-C regulator (P1.08) while idle instead
	  of relying on the chip's power-down mode.

config SNOWGAUGE_AUTO_MEASURE_PERIOD_S
	int "Automatic measurement period at boot (s, 0 = shell only)"
	default 0
	help
	  When non-zero the firmware runs a full measurement cycle every N
	  seconds without any shell interaction. Can be changed at run time
	  with the 'auto' shell command.

config SNOWGAUGE_BLE_ADV_INT_MIN_MS
	int "BLE advertising interval, minimum (ms)"
	default 1000
	range 20 10240
	help
	  Spec section 12.2: 1-2 s. The interval is the main BLE power knob;
	  can be changed at run time with the 'ble adv' shell command.

config SNOWGAUGE_BLE_ADV_INT_MAX_MS
	int "BLE advertising interval, maximum (ms)"
	default 2000
	range 20 10240

config SNOWGAUGE_VBAT_MIN_MV
	int "Minimum battery voltage for a TFmini capture (mV)"
	default 4600
	help
	  Below this the 5 V sensor LDO is out of regulation and the 120 mA
	  burst can brown out the board; the measurement then records only
	  Vbat, tilt and temperature.

config SNOWGAUGE_BOOT_HOLDOFF_MIN
	int "Delay of the first scheduled measurement after a reset (min)"
	default 10
	help
	  A reset restores the clock from the last record, which would make the
	  scheduler fire immediately (and again after every brown-out reset).
	  The first scheduled measurement is held off by this many minutes,
	  multiplied by the number of resets within the last hold-off window.

config SNOWGAUGE_SCHED_DEFAULT_INTERVAL_MIN
	int "Default measurement interval until configured (min, 0 = off)"
	default 180
	help
	  Spec: 8 measurements/day. Overridden by the stored sg/sched/* settings.

config SNOWGAUGE_SCHED_DEFAULT_TZ_MIN
	int "Default UTC offset of the site (min)"
	default 540

endmenu

source "Kconfig.zephyr"
